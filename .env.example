# Copy to .env.local and fill in from your NEW Supabase project
# (Project Settings → API). Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (or the legacy "anon public" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (or the legacy "service_role" key) — server only
SUPABASE_SECRET_KEY=

# End-to-end test accounts (only in .env.test.local, for the TEST project)
# E2E_BASE_URL=http://localhost:3000
# E2E_TECH_EMAIL=
# E2E_TECH_PASSWORD=
# E2E_REVIEWER_EMAIL=
# E2E_REVIEWER_PASSWORD=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
